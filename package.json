{
  "name": "insurance-calculator",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbo",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test:insurance": "tsx tests/generation2021.test.ts && tsx tests/generation2021.correctness.test.ts && tsx tests/multiClaim.test.ts && tsx tests/multiClaim2021.test.ts && tsx tests/generation2026.test.ts && tsx tests/multiClaim2026.test.ts && tsx tests/regulatoryRules.test.ts",
    "test:all": "node scripts/run-tests.mjs",
    "test:coverage": "c8 --all --src src/lib/insurance --check-coverage --lines 99 --statements 99 --functions 90 --branches 80 --reporter=text --reporter=json-summary node scripts/run-tests.mjs"
  },
  "dependencies": {
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "autoprefixer": "10.5.4",
    "c8": "^12.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.1",
    "postcss": "8.5.26",
    "tailwindcss": "3.4.17",
    "tsx": "4.23.12",
    "typescript": "5.9.3"
  }
}
